{
  "name": "@kekonic/diagrams-ui",
  "version": "1.0.0-rc.8",
  "description": "Shared chrome styles, KDiagram syntax highlighting, and React embeds as thin Lit wrappers.",
  "homepage": "https://github.com/kekonic/diagrams#readme",
  "bugs": {
    "url": "https://github.com/kekonic/diagrams/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kekonic/diagrams.git",
    "directory": "packages/diagrams-ui"
  },
  "files": [
    "dist",
    "src/chrome",
    "src/diagram"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./chrome.css": "./src/chrome/tokens.css",
    "./live.css": "./src/diagram/live.css",
    "./playground.css": "./src/diagram/playground.css",
    "./playground": {
      "types": "./dist/playground.d.mts",
      "import": "./dist/playground.mjs"
    },
    "./highlight": {
      "types": "./dist/shiki/highlight.d.mts",
      "import": "./dist/shiki/highlight.mjs"
    },
    "./shiki": {
      "types": "./dist/shiki/kdiagram.d.mts",
      "import": "./dist/shiki/kdiagram.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test"
  },
  "dependencies": {
    "@kekonic/diagrams": "workspace:*",
    "@kekonic/diagrams-core": "workspace:*",
    "@kekonic/diagrams-element": "workspace:*",
    "@lit/react": "catalog:",
    "shiki": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
