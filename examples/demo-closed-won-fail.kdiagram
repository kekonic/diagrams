diagram "Closed Won fails" {
  direction LR

  presentation {
    groupAccent: true
  }

  edges {
    route: metro
    crossings: jumps
  }

  group platform {
    arrange: row
    align: stretch

    group start "Membership first" {
      arrange: stack
      salesforce: external "Salesforce" { icon: cloud }
      mas: service "Request membership account" {
        icon: users
        note: "Household write succeeds"
      }
      hrp: external "HealthRules Connector" { icon: plug }
    }

    group sideWork "Also runs in parallel" {
      arrange: stack
      share: success "Request share account" { icon: handshake }
      charge: success "Charge first-month share" { icon: credit-card }
      okta: success "Create Okta user accounts" { icon: key-round }
      closedWon: failure "Notify Salesforce Closed Won" {
        icon: trophy
        note: "Fails — log and continue"
      }
    }

    group close "Result" {
      arrange: stack
      lookup: success "Household still visible in lookup" { icon: search }
    }
  }

  salesforce => mas "Application Complete" { priority: high }
  mas -> hrp "Write" { priority: high }
  mas -> share { priority: high }
  mas -> charge { priority: high }
  mas -> okta { priority: high }
  mas -> closedWon { priority: high }
  share -> lookup { priority: high }
  charge -> lookup { priority: high }
  okta -> lookup { priority: high }
  closedWon -x lookup "Fail, continue"
}
