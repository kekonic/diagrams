diagram "Duplicate activate" {
  direction LR

  presentation {
    title: "Duplicate activate"
    titleSubtitle: "Same Salesforce account twice — still one household"
    groupAccent: true
  }

  layout {
    density: normal
    considerModelOrder: true
  }

  edges {
    route: metro
    crossings: jumps
  }

  first: external "First Application Complete" {
    icon: cloud
    note: "Creates the household"
  }
  household: success "Household created" { icon: users }
  second: external "Second Application Complete" {
    icon: cloud
    note: "Same Salesforce account"
  }
  mas: service "Request membership account" { icon: users }
  idempotent: warning "Household already exists" {
    icon: copy
    note: "No second household"
  }
  lookup: success "Lookup still finds one household" { icon: search }

  first => household { priority: high }
  second => mas { priority: high }
  mas -> idempotent { priority: high }
  household -> lookup { priority: high }
  idempotent -> lookup { priority: high }
}
