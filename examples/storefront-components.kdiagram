kdiagram 1

diagram "API application — components" {
  layout {
    direction: LR
    density: spacious
    spacingScale: 1.05
    groupLayout: compound
    considerModelOrder: true
  }
  edges {
    route: orthogonal
    crossings: gaps
    cornerRadius: 4
  }
  presentation {
    title: auto
    titleSubtitle: "C4 component — internals of the API application. Other containers stay closed."
    groupAccent: false
    showKindSubtitles: true
  }

  web: container "Web application" {
    technology: "SPA"
    description: "The storefront that places orders over HTTPS."
  }

  boundary api "API application" {
    arrange: stack
    align: stretch
    gap: 28

    controller: component "Orders controller" {
      technology: "HTTP"
      description: "Handles checkout requests and maps them into order commands."
    }
    orders: component "Order service" {
      description: "Applies order policy, records the outbox, and requests payment."
    }
    payments: component "Payment client" {
      description: "Authorizes card charges through Stripe."
    }
    repo: component "Order repository" {
      description: "Reads and writes orders in the orders database."
    }
    publisher: component "Outbox publisher" {
      description: "Publishes OrderPlaced after the checkout transaction commits."
    }
  }

  group neighbors {
    chrome: false
    arrange: stack
    align: stretch

    ordersDb: container "Orders database" {
      shape: cylinder
      technology: "PostgreSQL"
      description: "Stores orders and the transactional outbox."
    }
    stripe: external "Stripe" {
      description: "Card payment service used to authorize charges."
    }
    inventory: container "Inventory service" {
      technology: "Node.js"
      description: "Reserves stock after OrderPlaced."
    }
    notifications: container "Notification worker" {
      technology: "Node.js"
      description: "Sends confirmation email after OrderPlaced."
    }
  }

  web -> controller "Places orders [JSON/HTTPS]" { priority: high }
  controller -> orders "CreateOrder" { priority: high }
  orders -> payments "Authorize payment"
  payments -> stripe "Authorizes charges [HTTPS]"
  orders -> repo "Save order + outbox"
  repo -> ordersDb "Reads and writes orders [SQL]"
  orders -> publisher "Enqueue OrderPlaced"
  publisher => inventory "Publishes OrderPlaced"
  publisher => notifications "Publishes OrderPlaced"
}
