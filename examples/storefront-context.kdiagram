kdiagram 1

diagram "Storefront — system context" {
  layout {
    direction: TD
    arrange: stack
    density: spacious
    spacingScale: 1.05
    considerModelOrder: true
  }
  edges {
    route: orthogonal
    crossings: gaps
  }
  presentation {
    title: auto
    titleSubtitle: "C4 context — people and software systems around the commerce platform. No internal containers."
    groupAccent: false
    showKindSubtitles: true
  }

  customer: person "Customer" {
    description: "A shopper browsing the catalog and placing orders."
  }

  boundary company "Commerce Co." {
    platform: system "Commerce platform" {
      description: "Lets customers check out and coordinates payment, fulfillment, and email."
    }
  }

  group externals {
    chrome: false
    arrange: row
    align: stretch

    stripe: external "Stripe" {
      description: "Card payment service used to authorize charges."
    }
    warehouse: external "Warehouse" {
      description: "Fulfillment partner that pick-packs and ships orders."
    }
    email: external "Email provider" {
      description: "Sends transactional mail such as order confirmations."
    }
  }

  customer -> platform "Places orders and checks status [HTTPS]"
  platform -> stripe "Authorizes card payments [HTTPS]"
  platform -> warehouse "Releases pick-and-pack work"
  platform -> email "Sends order confirmations [SMTP]"
}
