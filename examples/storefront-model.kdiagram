kdiagram 2

import "./storefront-core.kdiagram"

model "Storefront" {
  view context {
    intent {
      audience: "Developers joining the commerce platform"
      question: "Who uses the platform and which software systems sit outside it?"
      scope: [customer, platform, stripe, warehouse, email]
      omits: "Internal containers, databases, and event infrastructure"
      assumptions: "Stripe is the only named payment vendor"
    }

    include customer, commerce, partners
    collapse commerce as platform: system "Commerce platform"

    layout {
      direction: TD
      arrange: stack
      density: spacious
      spacingScale: 1.05
      considerModelOrder: true
    }
    edges {
      route: orthogonal
      crossings: gaps
    }
    presentation {
      title: auto
      titleSubtitle: "C4 context — one model, derived lens. People and software systems only."
      groupAccent: false
      showKindSubtitles: true
    }
  }

  view containers {
    intent {
      audience: "Backend engineers onboarding to the platform"
      question: "Which applications and stores make up the commerce platform?"
      omits: "C4 component internals and separate database cylinders"
      assumptions: "Checkout HTTP and order lifecycle share one API application"
    }

    include customer, commerce.*, stripe, warehouse, email
    exclude ordersDb

    layout {
      direction: LR
      density: spacious
      spacingScale: 1.05
      groupLayout: compound
      considerModelOrder: true
    }
    edges {
      route: orthogonal
      crossings: gaps
      cornerRadius: 4
    }
    presentation {
      title: auto
      titleSubtitle: "C4 container — derived from the same semantic model as context"
      groupAccent: false
      showKindSubtitles: true
    }
  }
}
