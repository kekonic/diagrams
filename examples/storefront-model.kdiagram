kdiagram 2

model "Storefront" {
  customer: person "Customer" {
    description: "A shopper browsing the catalog and placing orders."
  }

  boundary company "Commerce Co." {
    boundary commerce "Commerce platform" {
      arrange: grid
      columns: 4
      align: stretch
      gap: 40

      zone experience {
        column: 1
        arrange: stack

        web: container "Web application" {
          technology: "SPA"
          description: "Lets customers browse the catalog and submit checkout."
        }
      }

      zone application {
        column: 2
        arrange: stack

        api: container "API application" {
          technology: "Node.js"
          description: "Accepts orders, authorizes payment, and records the outbox."
        }
        notifications: container "Notification worker" {
          technology: "Node.js"
          description: "Sends order confirmation email after OrderPlaced."
        }
      }

      zone records {
        column: 3
        arrange: stack

        ordersDb: container "Orders database" {
          shape: cylinder
          technology: "PostgreSQL"
          description: "Stores orders and the transactional outbox."
        }
      }

      zone stock {
        column: 4
        arrange: stack

        inventory: container "Inventory service" {
          technology: "Node.js"
          description: "Reserves stock and releases warehouse picks."
        }
        inventoryDb: container "Inventory database" {
          shape: cylinder
          technology: "PostgreSQL"
          description: "Stores stock levels for reservations."
        }
      }
    }
  }

  group externals {
    chrome: false
    arrange: row
    align: stretch

    stripe: external "Stripe" {
      description: "Card payment service used to authorize charges."
    }
    warehouse: external "Warehouse" {
      description: "Fulfillment partner that pick-packs and ships orders."
    }
    email: external "Email provider" {
      description: "Sends transactional mail such as order confirmations."
    }
  }

  customer -> web "Browses and checks out [HTTPS]" { priority: high }
  web -> api "Places orders [JSON/HTTPS]" { priority: high }
  api -> stripe "Authorizes payments [HTTPS]" { priority: high }
  api -> ordersDb "Reads and writes orders [SQL]" { priority: high }
  api => inventory "Publishes OrderPlaced"
  api => notifications "Publishes OrderPlaced"
  inventory -> inventoryDb "Reads and writes stock [SQL]"
  inventory -> warehouse "Releases picks"
  notifications -> email "Sends confirmation [SMTP]"

  view context {
    intent {
      audience: "Developers joining the commerce platform"
      question: "Who uses the platform and which software systems sit outside it?"
      scope: [customer, platform, stripe, warehouse, email]
      omits: "Internal containers, databases, and event infrastructure"
      assumptions: "Stripe is the only named payment vendor"
    }

    include customer, company, externals
    collapse commerce as platform: system "Commerce platform" {
      description: "Lets customers check out and coordinates payment, fulfillment, and email."
    }

    layout {
      direction: TD
      arrange: stack
      density: spacious
      spacingScale: 1.05
      considerModelOrder: true
    }
    edges {
      route: orthogonal
      crossings: gaps
    }
    presentation {
      title: auto
      titleSubtitle: "C4 context — people and software systems around the commerce platform. One model, derived lens."
      groupAccent: false
      showKindSubtitles: true
    }
  }

  view containers {
    intent {
      audience: "Backend engineers onboarding to the platform"
      question: "Which applications and stores make up the commerce platform?"
      omits: "C4 component internals"
      assumptions: "Checkout HTTP and order lifecycle share one API application"
    }

    include customer, commerce.*, stripe, warehouse, email

    layout {
      direction: LR
      density: spacious
      spacingScale: 1.05
      groupLayout: compound
      considerModelOrder: true
    }
    edges {
      route: orthogonal
      crossings: gaps
      cornerRadius: 4
    }
    presentation {
      title: auto
      titleSubtitle: "C4 container — applications and stores inside the commerce platform. Same model as context."
      groupAccent: false
      showKindSubtitles: true
    }
  }
}
