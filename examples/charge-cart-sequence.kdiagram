kdiagram 1

sequence "Charge a cart" {
  autonumber

  presentation {
    title: auto
    titleSubtitle: "HTTP calls and async events, each with the excerpt a reader needs."
    groupAccent: false
  }

  shopper: actor "Shopper" { icon: user }
  web: gateway "Web" { icon: waypoints }
  orders: service "Orders" { icon: receipt }
  payments: service "Payments" { icon: credit-card }
  bus: topic "orders.v1" { icon: radio-tower }

  shopper -> web "POST /checkout" {
    payload: "{
      \"cartId\": \"c_91\",
      \"tenders\": [\"card\"]
    }"
  }
  activate web

  web -> orders "PlaceOrder" {
    payload: "{
      \"cartId\": \"c_91\",
      \"idempotencyKey\": \"c_91\"
    }"
  }
  activate orders

  orders => payments "AuthorizeRequested" {
    payload: "{
      \"cartId\": \"c_91\",
      \"amount\": 4200,
      \"currency\": \"usd\"
    }"
  }
  activate payments

  payments --> orders "authorized" {
    payload: "{
      \"authRef\": \"auth_18\",
      \"status\": \"authorized\"
    }"
  }
  deactivate payments

  orders => bus "OrderPlaced" {
    payload: "{
      \"orderId\": \"o_44\",
      \"total\": 4200
    }"
  }

  web --> shopper "201 Created" {
    payload: "{
      \"orderId\": \"o_44\",
      \"status\": \"placed\"
    }"
  }
  deactivate orders
  deactivate web
}
