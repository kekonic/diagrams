diagram "Order service — ports and adapters" {
  density spacious
  presentation { groupAccent: true }
  edges {
    route: bezier
    crossings: gaps
  }

  group composition {
    chrome: false
    arrange: row
    align: center

    group input "" {
      chrome: false

      httpClient: service "HTTP Client" { icon: service }
      externalTrigger: rect "External Trigger" { icon: service }
      messageBroker: rect "Message Broker" { icon: queue }
      user: actor "User" { icon: user }
    }

    group app "" {
      chrome: true
      arrange: row
      shape: hexagon

      group driving "Driving / User Interface" {
        chrome: false
        arrange: stack
        httpAdapter: component "OrderHttpAdapter" {
          subtitle: Driving
          icon: waypoints
        }
        graphqlAdapter: component "OrderGraphqlAdapter" {
          subtitle: Driving
          icon: share-2
        }
        stripeWebhook: component "StripeWebhookAdapter" {
          subtitle: Driving
          icon: "simple-icons:stripe"
          iconPaint: brand
        }
        kafkaAdapter: component "OrderKafkaAdapter" {
          subtitle: Driving
          icon: radio-tower
        }
        cliAdapter: component "OrderCliAdapter" {
          subtitle: Test
          icon: terminal
          styles: ["muted"]
        }
      }

      group appLayer "" {
        shape: hexagon
        arrange: surround

        group stack "" {
          arrange: stack
          shape: hexagon
          useCase: component "CreateOrderHandler" {
            subtitle: "Application Use Case"
            icon: receipt
            styles: ["info"]
          }
          group domain "Domain" {
            order: aggregate "Order" {
              subtitle: Domain
              icon: package
            }
          }
        }

        createOrder: interface "CreateOrderCommand" {
          subtitle: "Inbound Port"
          side: west
        }

        eventsPort: interface "EventPublishPort" {
          subtitle: "Outbound Port"
          side: east
        }
        orderRepo: interface "OrderRepositoryPort" {
          subtitle: "Outbound Port"
          side: east
        }
        paymentsPort: interface "PaymentPort" {
          subtitle: "Outbound Port"
          side: east
        }
      }

      group driven "Driven / Infra" {
        chrome: false
        arrange: stack
        stripeClient: component "StripePaymentAdapter" {
          subtitle: Driven
          icon: "simple-icons:stripe"
          iconPaint: brand
        }
        postgresAdapter: component "PostgresOrderAdapter" {
          subtitle: Driven
          icon: database
        }
        inMemoryAdapter: component "InMemoryOrderAdapter" {
          subtitle: Test
          icon: boxes
          styles: ["muted"]
        }
        outboxPublisher: component "OutboxPublishAdapter" {
          subtitle: Driven
          icon: send
        }
      }
    }

    group output "" {
      chrome: false

      stripe: external "Stripe" { styles: ["muted"] }
      pg: database "Database" { icon: postgres }
      kafka: topic "orders.v1" { icon: radio-tower }
    }
  }

  httpAdapter ..> createOrder "maps to"
  graphqlAdapter ..> createOrder
  stripeWebhook ..> createOrder
  kafkaAdapter ..> createOrder
  cliAdapter ..> createOrder
  createOrder ..> useCase
  useCase ..> order "uses"
  useCase ..> orderRepo "depends on"
  useCase ..> paymentsPort "depends on"
  useCase ..> eventsPort "depends on"
  postgresAdapter ..> orderRepo "implements"
  inMemoryAdapter ..> orderRepo "implements"
  stripeClient ..> paymentsPort "implements"
  outboxPublisher ..> eventsPort "implements"
  postgresAdapter -> pg "persists"
  stripeClient -> stripe "authorizes"
  outboxPublisher => kafka "publishes"

  httpClient -> httpAdapter
  httpClient <.. httpAdapter
  httpClient -> graphqlAdapter
  httpClient <.. graphqlAdapter
  externalTrigger -> stripeWebhook
  messageBroker -> kafkaAdapter
  user -> cliAdapter
}
