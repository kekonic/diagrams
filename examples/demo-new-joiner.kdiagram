diagram "New joiner" {
  direction LR

  presentation {
    title: "New joiner"
    titleSubtitle: "Happy path — active household end to end"
    groupAccent: true
  }

  layout {
    density: normal
    spacingScale: 1.08
    considerModelOrder: true
    groupLayout: compound
    nodePlacement: balanced
  }

  edges {
    route: metro
    crossings: jumps
  }

  group platform {
    chrome: false
    arrange: row
    align: stretch

    group publish "Start" {
      arrange: stack
      salesforce: external "Salesforce" {
        icon: cloud
        note: "Application Complete"
      }
      workflow: worker "Account activation workflow" {
        icon: workflow
        subtitle: true
        technology: "Temporal"
      }
    }

    group membership "Membership account" {
      arrange: stack
      mas: service "Request membership account" {
        icon: users
        note: "Validate and write to HealthRules"
        subtitle: true
        technology: "Member Activation Service"
      }
      hrp: external "HealthRules Connector" { icon: plug }
      active: success "Active household" { icon: circle-check }
    }

    group sideWork "Also runs in parallel" {
      arrange: stack
      share: process "Request share account" { icon: handshake }
      charge: process "Charge first-month share" { icon: credit-card }
      okta: process "Create Okta user accounts" { icon: key-round }
      closedWon: process "Notify Salesforce Closed Won" { icon: trophy }
    }

    group close "Downstream" {
      arrange: stack
      cornerstone: service "Cornerstone" { icon: database }
      ods: database "Operational data store" { icon: database }
      lookup: success "Lookup finds the household" { icon: search }
    }
  }

  salesforce => workflow "Application Complete" { icon: mail; priority: high }
  workflow -> mas "Request membership account" { priority: high }
  mas -> hrp "Write" { priority: high }
  mas -> active { priority: high }
  hrp ~> cornerstone "Eventually"

  active -> share { priority: high }
  active -> charge { priority: high }
  active -> okta { priority: high }
  active -> closedWon { priority: high }

  cornerstone -> ods "Project" { priority: high }
  ods -> lookup { priority: high }
}
