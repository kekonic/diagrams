diagram "On-hold household" {
  direction LR

  presentation {
    title: "On-hold household"
    titleSubtitle: "Programs present, no owner — Okta skipped"
    groupAccent: true
  }

  layout {
    density: normal
    spacingScale: 1.05
    considerModelOrder: true
    groupLayout: compound
  }

  edges {
    route: metro
    crossings: jumps
  }

  group platform {
    chrome: false
    arrange: row
    align: stretch

    group start "Start" {
      arrange: stack
      salesforce: external "Salesforce" {
        icon: cloud
        note: "Samuel only, no owner"
      }
      workflow: worker "Account activation workflow" { icon: workflow }
      mas: warning "Request membership account" {
        icon: users
        note: "Writes an on-hold household"
      }
    }

    group sideWork "Also runs in parallel" {
      arrange: stack
      share: process "Request share account" { icon: handshake }
      charge: process "Charge first-month share" { icon: credit-card }
      okta: warning "Create Okta user accounts" {
        icon: key-round
        note: "Skipped when there is no owner"
      }
      closedWon: process "Notify Salesforce Closed Won" { icon: trophy }
    }

    group close "Result" {
      arrange: stack
      lookup: warning "Lookup finds on-hold household" { icon: search }
    }
  }

  salesforce => workflow "Application Complete" { priority: high }
  workflow -> mas { priority: high }
  mas -> share { priority: high }
  mas -> charge { priority: high }
  mas ..> okta "Skipped"
  mas -> closedWon { priority: high }
  mas -> lookup { priority: high }
}
