diagram "demo:ardr" {
  direction TD

  presentation {
    title: "pnpm demo:ardr"
    titleSubtitle: "Accept now, result later — needs pnpm up:ardr"
    groupAccent: true
  }

  layout {
    density: normal
    considerModelOrder: true
  }

  edges {
    route: metro
    crossings: jumps
  }

  cli: external "Demo CLI" {
    icon: terminal
    note: "Posts job, then polls"
  }

  group acceptNow "Accept-now path" {
    arrange: stack
    engine: gateway "Accept-now engine" {
      icon: timer
      note: "202 + job id"
    }
    dispatcher: worker "Dispatcher" {
      icon: route
      note: "Ids-only queue message"
    }
    mas: service "Member Activation Service" { icon: users }
    hrp: external "HealthRules Connector" {
      icon: plug
      subtitle: true
      technology: "mock-hrp"
    }
    results: worker "Result handler" { icon: inbox }
    outbound: queue "Outbound message queue" { icon: mail }
  }

  cli -> engine "post job" { priority: high }
  engine => dispatcher "store payload, queue ids-only" { icon: mail; priority: high }
  dispatcher -> mas "route" { priority: high }
  mas -> hrp "validate and write" { priority: high }
  mas => results "complete on results queue" { priority: high }
  results -> engine "update job status" { priority: high }
  results => outbound "publish"
  cli -> engine "poll job status"
  engine -> cli "complete"
}
