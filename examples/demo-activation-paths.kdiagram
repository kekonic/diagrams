diagram "Account activation paths" {
  direction LR

  presentation {
    title: "Account activation paths"
    titleSubtitle: "Happy path and validation failure after a common start"
    groupAccent: true
  }

  layout {
    density: normal
    spacingScale: 1.08
    considerModelOrder: true
    groupLayout: compound
    nodePlacement: balanced
  }

  edges {
    route: metro
    crossings: jumps
  }

  group platform {
    chrome: false
    arrange: row
    align: stretch

    group start "Start" {
      arrange: stack
      salesforce: external "Salesforce" {
        icon: cloud
        note: "Application Complete"
      }
      workflow: worker "Account activation workflow" {
        icon: workflow
        subtitle: true
        technology: "Temporal"
      }
      mas: service "Request membership account" {
        icon: users
        note: "Member Activation Service"
      }
      hasPrograms: choice "Programs present?"
    }

    group lanes {
      chrome: false
      arrange: stack
      align: stretch

      group success "Happy path" {
        arrange: row
        align: stretch

        group happyOutcome "Household" {
          arrange: stack
          active: success "Active household" { icon: circle-check }
        }

        group happySide "Also runs in parallel" {
          arrange: stack
          share: process "Request share account" { icon: handshake }
          charge: process "Charge first-month share" { icon: credit-card }
          okta: process "Create Okta user accounts" { icon: key-round }
          closedWon: process "Notify Salesforce Closed Won" { icon: trophy }
        }

        group happyClose "Downstream" {
          arrange: stack
          hrpOk: external "HealthRules Connector" { icon: plug }
          cornerstone: service "Cornerstone" { icon: database }
          odsOk: database "Operational data store" { icon: database }
          lookupOk: success "Lookup finds the household" { icon: search }
        }
      }

      group failure "Validation fails" {
        arrange: row
        align: stretch

        group failOutcome "Household" {
          arrange: stack
          rejected: failure "Activation rejected" {
            icon: circle-x
            note: "Programs required"
          }
        }

        group failEffects "Downstream" {
          arrange: stack
          hrpNo: external "HealthRules Connector" {
            icon: plug
            note: "Nothing written"
          }
          lookupEmpty: warning "Lookup finds nothing" { icon: search }
        }
      }
    }
  }

  salesforce => workflow "Application Complete" { icon: mail; priority: high }
  workflow -> mas "Request membership account" { priority: high }
  mas -> hasPrograms { priority: high }

  hasPrograms -> active "yes" { branch: yes; priority: high }
  hasPrograms -x rejected "no" { branch: no }

  active -> share { priority: high }
  active -> charge { priority: high }
  active -> okta { priority: high }
  active -> closedWon { priority: high }
  active -> hrpOk "Write" { priority: high }
  hrpOk ~> cornerstone "Eventually"
  cornerstone -> odsOk "Project" { priority: high }
  odsOk -> lookupOk { priority: high }

  rejected ..> hrpNo "No write"
  rejected -> lookupEmpty
}
