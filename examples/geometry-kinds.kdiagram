kdiagram 1

diagram "Geometry kinds" {
  direction LR
  presentation {
    title: "Geometry kinds"
    titleSubtitle: "Built-in shapes and aliases — catalog only, not a system map."
    groupAccent: false
    showKindSubtitles: false
  }
  layout {
    density: compact
    spacingScale: 1
    considerModelOrder: true
  }

  group catalog {
    arrange: grid
    columns: 2
    align: stretch

    group basics "Basics" {
      arrange: pack
      r: rectangle "Rect"
      round: rounded "Rounded"
      p: pill "Pill"
      ell: ellipse "Ellipse"
      cir: circle "O"
    }

    group flowchart "Flowchart" {
      arrange: pack
      d: diamond "Diamond"
      h: hexagon "Hexagon"
      para: parallelogram "IO"
      trap: trapezoid "Manual"
      tri: triangle "Warn"
    }

    group media "Media" {
      arrange: pack
      c: cylinder "Cylinder"
      cl: cloud "Cloud"
      doc: document "Doc"
      fold: folded-document "Note"
      per: person "Actor"
      q: queue "Q"
    }

    group aliases "Aliases" {
      arrange: pack
      a: diam "Alias◆"
      b: hex "Alias⬡"
      box: rect "Alias□"
      cap: capsule "Alias⬭"
    }
  }
}
