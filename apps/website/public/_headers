# Cloudflare Pages headers (copied into dist at build time).
/
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/pagefind/*
  Cache-Control: public, max-age=31536000, immutable

/studio/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' https://api.iconify.design; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; frame-ancestors *
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff

/studio/index.html
  Cache-Control: public, max-age=0, must-revalidate

/studio/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable
