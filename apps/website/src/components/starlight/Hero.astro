---
import Default from "@astrojs/starlight/components/Hero.astro";

const id = Astro.locals.starlightRoute.id ?? "";
// The splash template always renders a Hero, falling back to the page title.
// Home builds its own hero (and owns the #_top anchor), so suppress Starlight's
// to avoid a duplicate <h1> and a duplicate #_top id.
const ownsItsHero = id === "";
---

{ownsItsHero ? null : <Default />}
