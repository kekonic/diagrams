---
import Default from "@astrojs/starlight/components/PageTitle.astro";

const id = Astro.locals.starlightRoute.id ?? "";
const isGalleryEntry = id.startsWith("gallery/") && id !== "gallery";
// Home renders its own <h1> (and owns #_top) inside the hero it builds.
const isHome = id === "";
const title = Astro.locals.starlightRoute.entry.data.title;
---

{
  isHome ? null : isGalleryEntry ? (
    <h1 id="_top" class="kd-gallery-title">{title}</h1>
  ) : (
    <Default />
  )
}

<style>
  .kd-gallery-title {
    margin: 0 0 0.35rem;
    font-size: clamp(1.55rem, 2.4vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
</style>
