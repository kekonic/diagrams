---
/**
 * Kekonic Diagrams brand mark from the current logo artwork.
 */
import symbol from "../assets/kekonic-diagrams-symbol.svg?url";
import wordmark from "../assets/kekonic-diagrams-logo.svg?url";
import wordmarkReverse from "../assets/kekonic-diagrams-logo-reverse.svg?url";

interface Props {
  class?: string;
  title?: string;
  variant?: "mark" | "wordmark" | "wordmark-reverse";
}

const {
  class: className,
  title = "Kekonic Diagrams",
  variant = "mark",
} = Astro.props;

const src =
  variant === "wordmark" ? wordmark : variant === "wordmark-reverse" ? wordmarkReverse : symbol;
---

<img class:list={["kd-logo", `kd-logo--${variant}`, className]} src={src} alt={title} />

<style>
  .kd-logo {
    display: block;
    flex-shrink: 0;
    height: 1em;
    width: auto;
  }

  .kd-logo--wordmark,
  .kd-logo--wordmark-reverse {
    height: 2.35rem;
    max-width: min(22rem, 92vw);
  }
</style>
