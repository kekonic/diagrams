---
import KDiagramPlayground from "./KDiagramPlayground.astro";

interface Props {
  source: string;
  /** Viewport height for the diagram-first gallery stage. */
  height?: number;
  editorHeight?: number;
}

const { source, height = 620, editorHeight = 200 } = Astro.props;
---

{/* Diagram-first stage: tall live view, compact source under it. */}
<div class="kd-gallery-play not-content">
  <KDiagramPlayground
    source={source}
    layout="gallery"
    height={height}
    editorHeight={editorHeight}
    showThemeToggle={true}
    showViewControls={true}
  />
</div>
