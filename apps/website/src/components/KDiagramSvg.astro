---
import { renderKDiagramSvg } from "@kekonic/diagrams-ui";

interface Props {
  source: string;
  /** `"auto"` (default) follows `html[data-theme]`. Named `registerTheme` keys are allowed. */
  theme?: string;
  class?: string;
  /** Snapshot resolved paints (portable). Default false so docs inherit the site theme. */
  snapshotTheme?: boolean;
  shadows?: boolean;
  roundedCorners?: boolean;
}

const {
  source,
  theme = "auto",
  class: className,
  snapshotTheme = false,
  shadows,
  roundedCorners,
} = Astro.props;
const { svg, diagnostics } = await renderKDiagramSvg(source, {
  theme,
  snapshotTheme,
  ...(shadows != null ? { shadows } : {}),
  ...(roundedCorners != null ? { roundedCorners } : {}),
});
const errors = diagnostics.filter((d) => d.severity === "error");
---

<div class:list={["kd-diagram", "kd-diagram--svg", "not-content", className]}>
  <div class="kd-diagram__frame" set:html={svg} />
  {
    errors.length > 0 ? (
      <p class="kd-diagram__error" role="status">
        {errors.map((e) => e.message).join(" / ")}
      </p>
    ) : null
  }
</div>
